{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samt.app/schema/v3",
  "title": "SAMT state package v3",
  "type": "object",
  "required": ["package", "schemaVersion", "state"],
  "properties": {
    "package": { "const": "SAMT" },
    "schemaVersion": { "const": "3.0.0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2 },
    "timestamp": { "type": "string", "format": "date-time" },
    "state": {
      "type": "object",
      "required": ["schemaVersion", "categories", "tags", "units", "actions", "blocks", "actionLogs", "history"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^3\\." },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "tasks": { "type": "array" }, "quickTasks": { "type": "array" }, "reviews": { "type": "array" }, "bin": { "type": "array" }, "tombstones": { "type": "array" }, "importHistory": { "type": "array" },
        "activations": { "type": "array" }, "runs": { "type": "array" }, "occurrences": { "type": "array" }, "periods": { "type": "array" },
        "actionLogs": { "type": "array", "items": { "$ref": "#/$defs/log" } }, "history": { "type": "array" }, "settings": { "type": "object" }, "meta": { "type": "object" }
      }
    },
    "category": { "type": "object", "required": ["id", "name", "scope", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "scope": { "enum": ["action", "result", "both"] }, "status": { "enum": ["active", "archived"] }, "createdAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" } } },
    "tag": { "type": "object", "required": ["id", "categoryId", "name", "scope", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "categoryId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "scope": { "enum": ["action", "result", "both"] }, "status": { "enum": ["active", "archived"] } } },
    "unit": { "type": "object", "required": ["id", "name", "symbol", "dimension", "factor"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "symbol": { "type": "string" }, "dimension": { "type": "string" }, "baseUnitId": { "type": ["string", "null"] }, "factor": { "type": "number", "exclusiveMinimum": 0 }, "decimalPrecision": { "type": "integer", "minimum": 0 } } },
    "action": { "type": "object", "required": ["id", "name", "tagIds", "direction", "completion", "resultFields", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "tagIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "direction": { "enum": ["do", "avoid"] }, "completion": { "type": "object" }, "resultFields": { "type": "array", "maxItems": 10 }, "status": { "enum": ["active", "archived"] } } },
    "relationship": { "type": "object", "required": ["id", "parentBlockId", "kind", "refId", "position"], "properties": { "id": { "$ref": "#/$defs/id" }, "parentBlockId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["action", "block"] }, "refId": { "$ref": "#/$defs/id" }, "position": { "type": "integer", "minimum": 0 }, "config": { "type": "object" } } },
    "block": { "type": "object", "required": ["id", "type", "name", "definitionStatus", "relationships"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["collection", "action_list", "routine", "workflow", "project", "cycle", "target"] }, "name": { "type": "string" }, "definitionStatus": { "enum": ["LIBRARY", "ACTIVE", "PAUSED", "ARCHIVED"] }, "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }, "config": { "type": "object" } } },
    "log": { "type": "object", "required": ["id", "actionId", "eventAt", "durationMinutes", "resultValues", "actionSnapshot"], "properties": { "id": { "$ref": "#/$defs/id" }, "actionId": { "$ref": "#/$defs/id" }, "eventAt": { "$ref": "#/$defs/timestamp" }, "durationMinutes": { "type": "number", "minimum": 0 }, "quantity": { "type": ["number", "null" ] }, "resultValues": { "type": "array" }, "contextRefs": { "type": "array" }, "actionSnapshot": { "type": "object" } } }
  }
}
